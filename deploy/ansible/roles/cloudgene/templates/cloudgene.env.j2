# Managed by Ansible - do not edit by hand.
DEBUG=False
DJANGO_SECRET_KEY={{ cloudgene_django_secret_key }}
ALLOWED_HOSTS={{ cloudgene_domain }}
CSRF_TRUSTED_ORIGINS=http{{ 's' if cloudgene_tls_enabled | bool else '' }}://{{ cloudgene_domain }}

DATABASE_URL=postgres://{{ cloudgene_db_user }}:{{ cloudgene_db_password | urlencode }}@127.0.0.1:5432/{{ cloudgene_db_name }}
DB_CONN_MAX_AGE=60

CLOUDGENE_HOME={{ cloudgene_home }}

LOG_LEVEL=INFO
LOG_FORMAT=json

{% if cloudgene_tls_enabled | bool %}
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_BEHIND_TLS_PROXY=1
DJANGO_HSTS_SECONDS={{ cloudgene_hsts_seconds }}
DJANGO_HSTS_PRELOAD=0
{% endif %}

DJANGO_DATA_UPLOAD_MAX_NUMBER_FILES=10000
API_JSON_BODY_MAX_MB=10
